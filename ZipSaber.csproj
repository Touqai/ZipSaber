<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <BeatSaberPluginsDir>Z:\SteamLibrary\steamapps\common\Beat Saber\Plugins</BeatSaberPluginsDir>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ZipSaber</AssemblyName>
    <RootNamespace>ZipSaber</RootNamespace>
    <Version>2.13.6</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <!-- Target game version. Build for another version with: dotnet build -p:GameVersion=1.44.1
         Game references come from Libs-<version> if that folder exists, else Libs. -->
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.40.8</GameVersion>
    <GameLibs Condition=" '$(GameLibs)' == '' and Exists('Libs-$(GameVersion)') ">Libs-$(GameVersion)</GameLibs>
    <GameLibs Condition=" '$(GameLibs)' == '' ">Libs</GameLibs>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>

    <!-- ── BSIPA ──────────────────────────────────────────────────────────── -->
    <Reference Include="IPA.Loader">
      <HintPath>$(GameLibs)\IPA.Loader.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- ── Unity Engine ───────────────────────────────────────────────────── -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameLibs)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameLibs)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameLibs)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(GameLibs)\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameLibs)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameLibs)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameLibs)\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- ── Beat Saber game assemblies ────────────────────────────────────── -->
    <Reference Include="HMLib">
      <HintPath>$(GameLibs)\HMLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HMUI">
      <HintPath>$(GameLibs)\HMUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BeatSaber.ViewSystem">
      <HintPath>$(GameLibs)\BeatSaber.ViewSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Main">
      <HintPath>$(GameLibs)\Main.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- ── Mod dependencies ───────────────────────────────────────────────── -->
    <Reference Include="SongCore">
      <HintPath>$(GameLibs)\SongCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BeatSaberMarkupLanguage">
      <HintPath>$(GameLibs)\BSML.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- ── .NET framework assemblies ─────────────────────────────────────── -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Runtime" />

    <!-- ── Source files ───────────────────────────────────────────────────── -->
    <Compile Include="Plugin.cs" />
    <Compile Include="PluginConfig.cs" />
    <Compile Include="DestinationModal.cs" />
    <Compile Include="MainThreadDispatcher.cs" />
    <Compile Include="ModInstallModal.cs" />
    <Compile Include="ModValidator.cs" />
    <Compile Include="ModInfo.cs" />
    <Compile Include="ModRegistry.cs" />
    <Compile Include="ModToggleService.cs" />
    <Compile Include="ModDetacher.cs" />
    <Compile Include="FlatView.cs" />
    <Compile Include="ViewportClickGuard.cs" />
    <Compile Include="Theme.cs" />
    <Compile Include="WipFolder.cs" />
    <Compile Include="Clipboard.cs" />
    <Compile Include="ScrollFix.cs" />
    <Compile Include="MiniJson.cs" />
    <Compile Include="PromptUi.cs" />
    <Compile Include="InlinePrompt.cs" />
    <Compile Include="ModFileOps.cs" />
    <Compile Include="WindowHost.cs" />
    <Compile Include="BeatModsCatalog.cs" />
    <Compile Include="IconFactory.cs" />
    <Compile Include="UiKit.cs" />
    <Compile Include="ManagerSettingsViewController.cs" />
    <Compile Include="SlotAudio.cs" />
    <Compile Include="GambleViewController.cs" />
    <Compile Include="SlotEffects.cs" />
    <Compile Include="CustomAssetInstaller.cs" />
    <Compile Include="ModManagerViewController.cs" />
    <Compile Include="ModManagerFlowCoordinator.cs" />
    <Compile Include="BeatModsBrowserViewController.cs" />

    <!-- ── Embedded resources ─────────────────────────────────────────────── -->
    <EmbeddedResource Include="$(IntermediateOutputPath)manifest.json" LogicalName="ZipSaber.manifest.json" />
    <EmbeddedResource Include="mod-manager.bsml" />
    <EmbeddedResource Include="beat-mods-browser.bsml" />
    <EmbeddedResource Include="zipsaber-settings.bsml" />
    <EmbeddedResource Include="gamble.bsml" />

  </ItemGroup>

  <!-- Copy built DLL to Beat Saber Plugins folder after build -->
  <Target Name="CopyFilesOnBuild" AfterTargets="Build" Condition="Exists('$(BeatSaberPluginsDir)')">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(BeatSaberPluginsDir)" />
    <Message Text="Copied $(AssemblyName).dll to $(BeatSaberPluginsDir)" Importance="High" />
  </Target>

  <!-- ZipSaber Stream companion window: built first, embedded into ZipSaber.dll -->
  <Target Name="BuildStreamWindow" BeforeTargets="BeforeBuild">
    <MSBuild Projects="ZipSaberWindow\ZipSaberWindow.csproj" Targets="Restore" Properties="Configuration=Release;_StreamRestore=1" />
    <MSBuild Projects="ZipSaberWindow\ZipSaberWindow.csproj" Targets="Build" Properties="Configuration=Release" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="ZipSaberWindow\bin\Release\ZipSaberWindow.exe" LogicalName="ZipSaber.ZipSaberWindow.exe" />
  </ItemGroup>
  <!-- manifest.json with "gameVersion" set to $(GameVersion) -->
  <Target Name="StampManifest" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_Manifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/manifest.json'))</_Manifest>
      <_Manifest>$([System.Text.RegularExpressions.Regex]::Replace('$(_Manifest)', '"gameVersion"\s*:\s*"[^"]*"', '"gameVersion": "$(GameVersion)"'))</_Manifest>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)manifest.json" Lines="$(_Manifest)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Message Importance="high" Text="ZipSaber: building for Beat Saber $(GameVersion) (references: $(GameLibs))" />
  </Target>
</Project>
