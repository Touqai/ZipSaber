<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xsi:schemaLocation='https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd'>
  <vertical spacing='1' pad='2' vertical-fit='PreferredSize' child-align='UpperCenter'>

    <!-- Header -->
    <horizontal bg='panel-top' pad-left='2' pad-right='3' pad-top='1' pad-bottom='1' spacing='2' child-align='MiddleLeft'>
      <button text='&lt;' on-click='go-back' pref-width='9' pref-height='7' font-size='4'
              hover-hint='Back to the Mod Manager'/>
      <vertical spacing='-1' child-align='MiddleLeft' flexible-width='1'>
        <text id='zs-tag' text='ZIPSABER' font-size='2.4' color='#5FA8E8' bold='true' align='Left'/>
        <text text='Browse BeatMods' font-size='4.5' bold='true' align='Left'/>
      </vertical>
      <text text='~status-label' font-size='3' align='Right' color='#AAAAAA' pref-width='55'/>
    </horizontal>

    <!-- Search bar -->
    <horizontal pad-left='1' pad-right='1' active='~list-visible'>
      <string-setting text='Search' value='search-text' apply-on-change='true'
                      on-change='search-changed' pref-width='110' pref-height='7'/>
    </horizontal>

    <!-- Sort -->
    <horizontal pad-left='1' pad-right='1' active='~list-visible'>
      <dropdown-list-setting text='Sort by' value='sort-mode' choices='sort-options'
                             apply-on-change='true' on-change='sort-changed' pref-width='110' pref-height='7'/>
    </horizontal>

    <!-- Mod list -->
    <scroll-view pref-height='37' pref-width='112' active='~list-visible'>
      <vertical id='mod-list-container' spacing='0.6' pad='1'
                child-align='UpperCenter' vertical-fit='PreferredSize' child-expand-width='true'>
      </vertical>
    </scroll-view>

    <!-- What the hovered mod does -->
    <vertical bg='round-rect-panel' pad-left='3' pad-right='3' pad-top='1' pad-bottom='1'
              pref-width='110' pref-height='14' child-align='UpperLeft' active='~list-visible'>
      <text text='~desc-text' font-size='2.9' align='TopLeft' word-wrapping='true'
            rich-text='true' pref-width='104' pref-height='11'/>
    </vertical>

    <!-- Install confirm panel -->
    <vertical bg='round-rect-panel' pad='3' spacing='2'
              child-align='UpperCenter' active='~confirm-visible'
              pref-width='112' pref-height='62'>
      <text text='~confirm-title' font-size='3.8' bold='true' align='Center'
            word-wrapping='true' pref-width='104'/>
      <horizontal spacing='1' child-align='MiddleCenter'>
        <button text='Restart &amp; Install Now' on-click='install-restart'
                pref-width='44' pref-height='9'/>
        <button text='Install on Close' on-click='install-close'
                pref-width='34' pref-height='9'/>
        <button text='Cancel' on-click='install-cancel'
                pref-width='18' pref-height='9'/>
      </horizontal>
      <text text='~auto-cancel-label' font-size='2.8' color='#888888' align='Center'/>
    </vertical>

    <!-- Footer -->
    <text text='~pending-label' font-size='3' color='#FFAA44'
          align='Center' active='~pending-visible'/>

  </vertical>
</bg>
